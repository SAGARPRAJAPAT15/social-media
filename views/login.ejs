<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body>
    <div
      class="w-full min-h-screen bg-zinc-900 flex items-center justify-center p-4"
    >
      <form
        action="/login"
        method="POST"
        class="w-full max-w-md bg-zinc-800 p-8 rounded-2xl shadow-2xl space-y-4"
      >
        <h1 class="text-3xl font-bold text-white text-center mb-6">
          Login Account
        </h1>

        <input
          type="email"
          name="email"
          placeholder="Email Address"
          class="w-full p-3 rounded-lg bg-zinc-700 text-white placeholder-zinc-400 outline-none focus:ring-2 focus:ring-blue-500"
        />

        <input
          type="password"
          name="password"
          placeholder="Password"
          class="w-full p-3 rounded-lg bg-zinc-700 text-white placeholder-zinc-400 outline-none focus:ring-2 focus:ring-blue-500"
        />

        <input
          type="submit"
          value="Login Account"
          class="w-full p-3 rounded-lg bg-blue-600 text-white font-semibold cursor-pointer hover:bg-blue-700 transition duration-300"
        />
      </form>
    </div>
  </body>
</html>
